# Production settings for the ChatDesk API on the EC2 server.
# setup_server.sh copies this file to /srv/chatdesk/backend/.env - fill in
# the values THERE (on the server), never in this file: this repo is public.
# Replace every <...>. See docs/DEPLOYMENT.md for where each value comes from.

# --- Django ---
# Generate one on the server: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=<long random string>
DEBUG=False
# Your DuckDNS name (no https://), plus localhost for checks on the server.
ALLOWED_HOSTS=<yourname>.duckdns.org,localhost,127.0.0.1
# The same DuckDNS name, with https:// (for the /admin login form).
CSRF_TRUSTED_ORIGINS=https://<yourname>.duckdns.org
# nginx tells Django the visitor used HTTPS with this header.
PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO

# --- Database (Neon project ChatDeskDB, AWS Sydney) ---
# Pooled address (contains "-pooler") for the running app.
DATABASE_URL=<postgresql://...-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require...>
# Direct address (no "-pooler"), used by update.sh for database table changes.
DATABASE_URL_UNPOOLED=<postgresql://....ap-southeast-2.aws.neon.tech/neondb?sslmode=require...>

# --- Who may call the API from a browser ---
# The two Cloudflare Pages addresses: the admin dashboard and the student web app.
CORS_ALLOWED_ORIGINS=https://<dashboard>.pages.dev,https://<student-app>.pages.dev

# --- Links put in emails ---
# The API's public address (email verification links point here).
PUBLIC_BASE_URL=https://<yourname>.duckdns.org
# The admin dashboard (link in the daily overdue reminder).
ADMIN_DASHBOARD_URL=https://<dashboard>.pages.dev

# --- OpenAI (chatbot) ---
OPENAI_API_KEY=<sk-...>

# --- Gmail (the ChatDesk Gmail sends all emails) ---
EMAIL_HOST_USER=<chatdesk gmail address>
EMAIL_HOST_PASSWORD=<16-character Gmail App Password>

# --- Defaults; change only if the team agrees ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1
ALLOWED_EMAIL_DOMAINS=
TICKET_OVERDUE_DAYS=2
FAQ_SEMANTIC_MATCHING=True
FAQ_MATCH_THRESHOLD=0.70
FAQ_MATCH_MARGIN=0.10
